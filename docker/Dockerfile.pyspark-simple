# Simple PySpark Dockerfile
FROM apache/spark:3.5.0-python3

USER root

# Install basic dependencies
RUN apt-get update && \
    apt-get install -y python3-pip curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python packages for PySpark
RUN pip3 install --no-cache-dir \
    pyspark==3.5.0 \
    pandas==2.0.3 \
    numpy==1.24.3 \
    scikit-learn==1.3.2

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=spark:spark ./app /app/app
COPY --chown=spark:spark ./data /app/data

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Create directories for Spark
RUN mkdir -p /tmp/spark-events /app/spark_checkpoints && \
    chown -R spark:spark /tmp/spark-events /app/spark_checkpoints

USER spark

# Expose Spark UI port
EXPOSE 4040

# Default command
CMD ["/bin/bash"]
