{
  "dashboard": {
    "id": null,
    "uid": "ml-system-health",
    "title": "ML System Health Dashboard",
    "tags": ["system", "health", "infrastructure"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Container CPU Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total[5m]) * 100",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Container Memory Usage",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "container_memory_usage_bytes / 1024 / 1024",
            "refId": "A",
            "legendFormat": "{{name}} (MB)"
          }
        ]
      },
      {
        "id": 3,
        "title": "Service Availability",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "up{job=\"recommendation-api\"}",
            "refId": "API",
            "legendFormat": "API"
          },
          {
            "expr": "up{job=\"streamlit\"}",
            "refId": "Streamlit",
            "legendFormat": "Streamlit"
          },
          {
            "expr": "up{job=\"postgres\"}",
            "refId": "PostgreSQL",
            "legendFormat": "PostgreSQL"
          },
          {
            "expr": "up{job=\"redis\"}",
            "refId": "Redis",
            "legendFormat": "Redis"
          },
          {
            "expr": "up{job=\"kafka\"}",
            "refId": "Kafka",
            "legendFormat": "Kafka"
          },
          {
            "expr": "up{job=\"chromadb\"}",
            "refId": "ChromaDB",
            "legendFormat": "ChromaDB"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "horizontal",
          "textMode": "name",
          "colorMode": "background",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      {
        "id": 4,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"ml_system\"}",
            "refId": "A",
            "legendFormat": "Active connections"
          }
        ]
      },
      {
        "id": 5,
        "title": "Redis Memory Usage",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true,
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.9, "color": "red" }
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Kafka Lag",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "kafka_consumer_lag_sum",
            "refId": "A",
            "legendFormat": "{{topic}} - {{partition}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
